<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sahl Union: shared with every Sahl app signed with the same key -->
    <permission android:name="com.sahl.permission.UNION" android:label="@string/union" android:protectionLevel="signature" />
    <uses-permission android:name="com.sahl.permission.UNION" />

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.sahl.home" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.aly.sahlsync" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.sahl.files" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.camera" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.tools" />
        <provider android:authorities="com.sahl.contacts.union" />
        <provider android:authorities="com.sahl.tools.union" />
        <intent><action android:name="com.sahl.phone.action.CALL" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SahlTheme">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MESSAGING" />
            </intent-filter>
        </activity>

        <activity android:name=".ThreadActivity" android:exported="true" android:windowSoftInputMode="adjustResize"
            android:permission="com.sahl.permission.UNION">
            <intent-filter><action android:name="com.sahl.messages.action.OPEN" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>

        <!-- Required for the default SMS app: compose from sms:/smsto: links and shares -->
        <activity android:name=".ComposeActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".StarredActivity" android:exported="false" />
        <!-- Sahl Union: message history for the people timeline in Sahl Contacts -->
        <provider android:name=".UnionProvider" android:authorities="com.sahl.messages.union"
            android:exported="true" android:readPermission="com.sahl.permission.UNION" />
        <activity android:name=".CrashActivity" android:exported="false" android:process=":crash" />

        <receiver android:name=".SmsDeliverReceiver" android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter><action android:name="android.provider.Telephony.SMS_DELIVER" /></intent-filter>
        </receiver>
        <receiver android:name=".MmsDeliverReceiver" android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <service android:name=".HeadlessSmsSendService" android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <receiver android:name=".SentReceiver" android:exported="false" />
        <receiver android:name=".DeliveredReceiver" android:exported="false" />
        <receiver android:name=".ScheduledReceiver" android:exported="false" />
        <receiver android:name=".MmsDownloadedReceiver" android:exported="false" />
        <receiver android:name=".MmsSentReceiver" android:exported="false" />
        <provider android:name=".MmsFileProvider" android:authorities="com.sahl.messages.mmsfiles"
            android:exported="false" android:grantUriPermissions="true" />
        <receiver android:name=".ActionReceiver" android:exported="false" />
    </application>
</manifest>
